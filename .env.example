# AgentForge 本地环境变量模板
#
# 用法：
#   1. 复制本文件为 `.env`（同目录）：  Copy-Item .env.example .env
#   2. 把下面的值换成你自己的
#   3. 直接跑，不需要再 `$env:DEEPSEEK_API_KEY=...`
#
# ⚠️ `.env` 已在 `.gitignore` 里，**绝不要**把它提交上去。
#    本文件（.env.example）是模板，不含任何真实值，可以提交。
#
# 关于优先级：**真实环境变量优先于 .env**。
# 所以临时覆盖仍然有效：`$env:DEEPSEEK_API_KEY="..."; node ...`
# 如果两者都有值，CLI 会打印「保留已有值 N 个」。

# DeepSeek（`agentforge.config.json` 里引用的是 `${DEEPSEEK_API_KEY}`）
DEEPSEEK_API_KEY=

# 换成其它 OpenAI 兼容端点时，把配置里的 apiKey 改成 `${OPENAI_API_KEY}` 之类即可
#OPENAI_API_KEY=
#MOONSHOT_API_KEY=

# 可选：让锚点 A4 用指定的 typescript 安装（默认自己找）
#AGENTFORGE_TS_PATH=
#AGENTFORGE_TS_DIR=

# 可选：打印完整错误堆栈
#AF_DEBUG=1
