  "generatedTypesPath": "src/shared/contract-types.ts",
  "changeRequests": [
    {
      "id": "CR-001",
      "reason": "R-022 要求所有响应（含不存在路由的错误响应）均为 JSON，但 OpenAPI 的 paths 只能声明已知路径，无法表达「任意未声明路径」的兜底行为。为避免契约路径集合膨胀并被误认作新增端点，契约不新增任何路径，兜底响应需由实现层的 catch-all 承担。",
      "evidence": [
        {
          "kind": "artifact",
          "artifactId": "Requirement-001"
        },
        {
          "kind": "artifact",
          "artifactId": "PRD-001"
        }
      ],
      "impact": [
        "契约 paths 集合保持为 {/health, /api/tasks, /api/tasks/{id}, /api/stats}，不新增路径",
        "后端需在路由分发末尾实现 catch-all：任何未匹配请求返回 404 + ErrorResponse，content-type 含 application/json",
        "测试需断言未知路径响应可被 JSON.parse 且 content-type 含 application/json",
        "不接受对该兜底行为做 200 或 HTML 文本响应"
      ],
      "falsifier": {
        "kind": "question",
        "text": "后端是否在所有已声明的 4 条路径之外，对一切未匹配请求统一返回 404 + ErrorResponse（content-type: application/json），而契约 paths 仍保持 4 条不变？"
      },
      "status": "proposed"
    },
    {
      "id": "CR-002",
      "reason": "需求未定义 GET /api/tasks 的 status / priority 查询参数取非法枚举值（如 ?status=blocked）时的行为：返回 400 还是忽略该过滤条件。契约把两个参数声明为枚举，但未约束该分支，若不澄清，测试对任一行为的断言都会与实现产生歧义。",
      "evidence": [
        {
          "kind": "artifact",
          "artifactId": "Requirement-001"
        },
        {
          "kind": "artifact",
          "artifactId": "TaskGraph-001"
        }
      ],
      "impact": [
        "测试不得对 ?status=<非法值> / ?priority=<非法值> 断言具体状态码或具体结果集",
        "后端可自行选择「忽略非法过滤值」或「按不匹配返回空数组」，契约不把它列为验收点",
        "契约中的 400 响应用于请求体校验失败（POST/PATCH），不用于过滤参数校验"
      ],
      "falsifier": {
        "kind": "question",
        "text": "当收到 ?status=blocked（枚举外的过滤值）时，期望 200 空数组还是 400？若两者皆可，是否确认该分支不进入任何验收点？"
      },
      "status": "proposed"
    }
  ]
}
